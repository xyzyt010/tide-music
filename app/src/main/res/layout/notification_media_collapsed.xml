<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root_collapsed"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="#1C1E24">

    <!-- Album Art Thumbnail (48dp) -->
    <ImageView
        android:id="@+id/notif_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note"
        android:contentDescription="Album Art" />

    <!-- Title & Artist -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tide Music"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ready to play"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Large Playback Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Previous Button (42dp) -->
        <ImageView
            android:id="@+id/notif_prev"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="7dp"
            android:src="@drawable/ic_notif_prev"
            android:contentDescription="Previous" />

        <!-- Circular Play/Pause Button (48dp) -->
        <FrameLayout
            android:id="@+id/notif_play_pause_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle_white">

            <ImageView
                android:id="@+id/notif_play_pause"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pause_black"
                android:contentDescription="Play/Pause" />
        </FrameLayout>

        <!-- Next Button (42dp) -->
        <ImageView
            android:id="@+id/notif_next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="7dp"
            android:src="@drawable/ic_notif_next"
            android:contentDescription="Next" />
    </LinearLayout>

</LinearLayout>
